# ~/.config/mako/config
max-visible=5
output=eDP-1
anchor=top-right
font=JetBrains Mono 10
width=350
margin=20
padding=15
border-size=2
border-radius=4
default-timeout=5000

# Ayu Mirage Colors
background-color=#212733f0
text-color=#cccac2ff
border-color=#ffcc66ff
progress-color=source #343f51ff

[urgency=low]
border-color=#5ccfe6ff
default-timeout=3000

[urgency=high]
border-color=#f28779ff
text-color=#f28779ff
default-timeout=0

